# ============================================================
#  AgroSoft Backend — Variables de entorno (PLANTILLA)
# ============================================================
# Copia este archivo como  .env  y rellena los valores reales.
# El archivo .env NUNCA debe subirse a GitHub (está en .gitignore).

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Seguridad ---
# Clave para firmar las sesiones. Genera una larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pega-aqui-una-clave-larga-y-aleatoria

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=agrosoft
DB_PASSWORD=pon-aqui-la-contrasena-de-la-base-de-datos
DB_NAME=agrosoft
DB_SSL=false

# --- Frontend autorizado (para CORS) ---
# Una o varias URLs separadas por coma. Ejemplos:
#   http://localhost:5173               (desarrollo)
#   https://app.agrofranpabel.com       (producción)
FRONTEND_URL=http://localhost:5173
